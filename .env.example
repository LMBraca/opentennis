# Pulled automatically by `neon deploy` into .env.local.
# apps/web/.env.local is a symlink to the root file, because Next only reads
# env files from its own project directory.

# Pooled (-pooler). Application query traffic.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct, no pooler. Migrations, pg_dump, logical replication, LISTEN/NOTIFY.
# Running a migration over the pooled URL fails in ways that never mention pooling.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

NEON_BRANCH="production"

# v1 is single-tenant: the id of the seeded organization row.
# Printed by: pnpm --filter @opentennis/db exec tsx src/seed.ts "Your Club"
OPENTENNIS_ORG_ID=""

# --- Admin invitations (optional for all other app features) -----------------
# Resend credentials and the verified sender are configured in Vercel.
# Set these locally only when testing an invitation; never commit their values.
RESEND_API_KEY=""
EMAIL_FROM=""

# Cloudflare Turnstile, for the public entry form. Optional: with neither set
# no challenge is shown and the form works exactly as before, and
# lib/turnstile.ts fails open on purpose — a spam gate that takes the entry
# form down with it is worse than the spam. Set BOTH or neither.
#
# NOTE the NEXT_PUBLIC_ prefix on the site key. It is read in the browser, so
# Next only exposes it under that name. This file said TURNSTILE_SITE_KEY
# until 2026-11-08, which is the worst possible spelling to get wrong: the
# app reads the prefixed name, finds nothing, treats Turnstile as unconfigured
# and serves the form with no challenge. No error, no warning, no challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Stripe (optional) -----------------------------------------------------
# Leave blank and the app runs exactly as before: no pay buttons, manual tick
# only. A Mexican Stripe account is required for OXXO and SPEI.
STRIPE_SECRET_KEY=""
# From `stripe listen` locally, or the dashboard endpoint in production.
# Without it the webhook refuses every request rather than trusting unsigned
# events — an unverified webhook is an open endpoint for marking entries paid.
STRIPE_WEBHOOK_SECRET=""

# --- Vercel Blob (RV-16, not yet built) ------------------------------------
# Blog image uploads. Created by `vercel blob store add` or in the dashboard;
# linking the store to the project injects this automatically, so you rarely
# set it by hand except for local development.
#
# next.config.ts currently sets `remotePatterns: []`, which is the SSRF guard
# on the image optimiser. When the store exists its hostname goes in there —
# that host and nothing else. Never a wildcard.
BLOB_READ_WRITE_TOKEN=""

# Pin the image optimiser to your exact blob host once the store exists.
# It is `<storeId>.public.blob.vercel-storage.com`, printed when you create
# the store. Without it next.config.ts falls back to a subdomain wildcard on
# Vercel's blob domain, which is still not an open optimiser but is wider
# than it needs to be.
BLOB_HOSTNAME=""
