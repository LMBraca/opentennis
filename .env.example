# Neon Postgres. Get this from the Neon console, or `vercel env pull`.
DATABASE_URL="postgresql://user:password@host.neon.tech/opentennis?sslmode=require"

# v1 is single-tenant: the id of the seeded organization row.
# Printed by `pnpm --filter @opentennis/db exec tsx src/seed.ts`.
OPENTENNIS_ORG_ID=""

# Cloudflare Turnstile, for the public entry form.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
