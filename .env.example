# Pulled automatically by `neon deploy` into .env.local.
# apps/web/.env.local is a symlink to the root file, because Next only reads
# env files from its own project directory.

# Pooled (-pooler). Application query traffic.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct, no pooler. Migrations, pg_dump, logical replication, LISTEN/NOTIFY.
# Running a migration over the pooled URL fails in ways that never mention pooling.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

NEON_BRANCH="production"

# v1 is single-tenant: the id of the seeded organization row.
# Printed by: pnpm --filter @opentennis/db exec tsx src/seed.ts "Your Club"
OPENTENNIS_ORG_ID=""

# Cloudflare Turnstile, for the public entry form (ENT-3, not yet built).
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Stripe (optional) -----------------------------------------------------
# Leave blank and the app runs exactly as before: no pay buttons, manual tick
# only. A Mexican Stripe account is required for OXXO and SPEI.
STRIPE_SECRET_KEY=""
# From `stripe listen` locally, or the dashboard endpoint in production.
# Without it the webhook refuses every request rather than trusting unsigned
# events — an unverified webhook is an open endpoint for marking entries paid.
STRIPE_WEBHOOK_SECRET=""
